{
  "name": "scraper-api",
  "version": "1.0.0",
  "description": "Web scraping API for JS-rendered sites (React, Vue, TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "import": "ts-node src/importer/cli.ts",
    "test": "node --require ts-node/register --test src/importer/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/lib-storage": "^3.1171.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
