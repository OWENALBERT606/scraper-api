# ---- MlegacyTV source (Supabase-backed catalog) ---------------------------------------------------------------------
MLEGACYTV_SUPABASE_URL=https://watch.ugandacinema.com
MLEGACYTV_SUPABASE_KEY=              # the public anon key from the MlegacyTV site

# ---- Importer: copies films from FreeWatch UG to MovieChamp256 ------------------------------------------------------
# Never commit real values. This file is only a template.

# The MovieChamp256 API (with /api/v1) and an ADMIN account used by the importer. The account must be able to create
# VJs, genres and release years and to read TMDB metadata, so use a dedicated administrator account.
PLATFORM_API_URL=http://api.moviechamp256.com/api/v1
PLATFORM_EMAIL=
PLATFORM_PASSWORD=

# IMPORT_MODE=link                # use "copy" on the server to store videos in your B2 bucket (default): films are added to the platform pointing at the source's video address. Nothing is downloaded
# and no B2 settings are needed. IMPORT_MODE=copy: the video is copied into B2 first (needs the B2 settings below).
IMPORT_MODE=link

# Backblaze B2 (only for IMPORT_MODE=copy): the SAME bucket the platform already uses for videos.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_KEY_ID=
B2_APPLICATION_KEY=         # (B2_APP_KEY, as the API names it, also works)
B2_BUCKET=                  # (B2_BUCKET_NAME also works)
B2_PUBLIC_URL=              # the same B2_PUBLIC_URL the API uses; stored video links start with it

# Optional
IMPORT_CONCURRENCY=1            # films copied at once (1 to 4); each one streams a whole file
IMPORT_SKIP_ANY_VJ=false        # true: skip a film when its title exists under ANY VJ (default: only under the same VJ)
IMPORT_CREATE_MISSING=true      # create a VJ / genre / year that does not exist yet
IMPORT_DEFAULT_VJ=              # VJ name for source films that name none (they are skipped when this is empty)
IMPORT_MIN_BYTES=20971520       # refuse files smaller than this (a saved error page is not a film)
IMPORT_SEARCH_TERMS=            # extra search words, comma separated, to find more titles
IMPORT_AUTORUN_MINUTES=0        # run automatically every N minutes, first run 30 s after start (0 = only when asked). Use 60 on the server
IMPORT_API_KEY=                 # required to call /api/import/* from outside the server (send it as the x-api-key header)
IMPORT_DATA_DIR=./data          # where the ledger of imported films is kept
